@ProjectTaskManagement_HostAddress = https://localhost:7xxx

### Register
POST {{ProjectTaskManagement_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "userName": "jdoe",
  "email": "jdoe@example.com",
  "password": "Password1"
}

### Login
POST {{ProjectTaskManagement_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "Admin@Admin.com",
  "password": "Admin@12345"
}

### Create project
POST {{ProjectTaskManagement_HostAddress}}/api/projects
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "New Backend Project",
  "description": "Clean Architecture implementation"
}

### Get projects
GET {{ProjectTaskManagement_HostAddress}}/api/projects
Authorization: Bearer {{accessToken}}

### Get project by id
GET {{ProjectTaskManagement_HostAddress}}/api/projects/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{accessToken}}

### Update project
PUT {{ProjectTaskManagement_HostAddress}}/api/projects/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Updated Project Name",
  "description": "Updated description"
}

### Delete project
DELETE {{ProjectTaskManagement_HostAddress}}/api/projects/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{accessToken}}

### Create task
POST {{ProjectTaskManagement_HostAddress}}/api/tasks
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Implement CQRS pipeline",
  "description": "MediatR behaviors",
  "priority": 2,
  "projectId": "00000000-0000-0000-0000-000000000000",
  "dueDate": "2026-06-01"
}

### Get tasks by project
GET {{ProjectTaskManagement_HostAddress}}/api/tasks/project/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{accessToken}}

### Update task status
PATCH {{ProjectTaskManagement_HostAddress}}/api/tasks/00000000-0000-0000-0000-000000000000/status
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": 1
}

### Delete task
DELETE {{ProjectTaskManagement_HostAddress}}/api/tasks/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{accessToken}}
